# Keelwork environment variables. Names and comments only — never commit real
# values. Each process reads only what it needs (see docs/operations/go-live-checklist.md,
# generated by `pnpm tsx scripts/env-vars.ts`). None of these is ever passed to customer apps.

# ---- Supabase (Keelwork's own database and auth) --------------------------
NEXT_PUBLIC_SUPABASE_URL=            # https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # public anon key; RLS protects everything
SUPABASE_SERVICE_ROLE_KEY=           # server-only: web app, worker, runner
NEXT_PUBLIC_SITE_URL=                # https://app.keelwork.example (used in emails and redirects)

# ---- Secrets vault --------------------------------------------------------
SECRETS_MASTER_KEYS=                 # "1:<openssl rand -base64 32>"; add "2:<…>" to rotate (highest encrypts)

# ---- AI (provider-neutral catalogue) --------------------------------------
AI_MODEL_CATALOG=                    # JSON; `pnpm tsx scripts/print-stack-catalog.ts` prints the Kimi + DeepSeek preset
MOONSHOT_API_KEY=                    # Kimi (Moonshot AI): plan / reason / chat routes
DEEPSEEK_API_KEY=                    # DeepSeek: code / review routes

# ---- Web research (agents' web.search) ------------------------------------
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COST_MICROS=            # price charged per search in micros, e.g. 5000; unpriced searches are refused

# ---- Sandbox broker (runs on a separate Docker host) ----------------------
SANDBOX_BROKER_URL=                  # web app + worker: https://broker.internal.example:7070
SANDBOX_BROKER_TOKEN=                # web app + worker: openssl rand -hex 32 (same value as BROKER_TOKEN)
BROKER_TOKEN=                        # broker + preview proxy
KW_APP_ORIGIN=                       # https://app.keelwork.example; passed into sandboxes for Design mode
SANDBOX_IMAGE=                       # optional, default keelwork/runtime-node:22
SANDBOX_NETWORK=                     # optional, default none; a dedicated egress-allowlisted Docker network
SANDBOX_RUNTIME=                     # optional: runsc (gVisor, recommended)
SANDBOX_MEMORY_MB=                   # optional, default 3072 (1024–16384); the /workspace tmpfs counts against it
PORT=                                # optional: broker 7070, preview proxy 8080
HOST=                                # optional: broker/preview proxy listen address, default 0.0.0.0 (127.0.0.1 on a one-machine setup)

# ---- Live previews --------------------------------------------------------
PREVIEW_BASE_DOMAIN=                 # preview.keelwork.example (wildcard DNS + TLS for *.<this>)
PREVIEW_SECRET=                      # openssl rand -hex 32; web app + preview proxy
APP_ORIGIN=                          # preview proxy: https://app.keelwork.example (only it may frame previews)
BROKER_URL=                          # preview proxy: the broker's URL

# ---- Worker ---------------------------------------------------------------
WORKER_CONCURRENCY=                  # optional, default 3
KW_TEMPLATES_DIR=                    # optional, default ./templates

# ---- Email (invitations) --------------------------------------------------
RESEND_API_KEY=                      # optional; without it invitation links are shown to share by hand
INVITE_FROM_EMAIL=                   # e.g. Keelwork <team@keelwork.example>

# ---- Stripe (Keelwork's own account) --------------------------------------
STRIPE_SECRET_KEY=                   # sk_test_… / sk_live_…; without it online payments are hidden
STRIPE_WEBHOOK_SECRET=               # whsec_… for /api/stripe/webhook
STRIPE_PRICE_PRO=                    # price_… for the Pro plan
STRIPE_PRICE_BUSINESS=               # price_… for the Business plan
CREDIT_PACKS=                        # [{"id":"10","credits_micros":10000000,"price_cents":1200,"currency":"usd"}]

# ---- OAuth providers (read by Supabase, see supabase/config.toml) ---------
AUTH_PROVIDERS=                      # optional: comma list of google,azure,github to show; unset = all, empty = email only
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

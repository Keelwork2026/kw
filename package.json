{
  "name": "keelwork",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts' 'services/**/*.test.ts' 'scripts/**/*.test.ts'",
    "test:db": "bash scripts/test-db.sh",
    "test:template": "cd templates/next-supabase && node --test 'tests/*.test.ts'",
    "drill": "bash scripts/backup-restore-drill.sh",
    "broker": "tsx services/sandbox-broker/server.ts",
    "proxy": "tsx services/preview-proxy/proxy.ts",
    "worker": "tsx services/agent-worker/src/worker.ts",
    "runner": "tsx services/automation-runner/runner.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^15.5.0",
    "postgres": "latest",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}

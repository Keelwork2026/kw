    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "codemirror": "^6.0.2",
    "next": "^15.5.0",
